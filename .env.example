# cups-web 与 CUPS
CUPS_WEB_URL=http://127.0.0.1:1180
PRINTER_URI=http://127.0.0.1:631/printers/Office_A4

# 每个个人微信用户对应其 cups-web 用户签发的一枚 API Key（在 cups-web「密钥」页面创建）。
# 该 JSON 必须覆盖 WECOM_ALLOWED_EXTERNAL_USERS 中的每个 external_userid；密钥以 cw_ 开头。
WECOM_CUPS_API_KEYS='{"wmAlice":"cw_请替换为alice的密钥","wmBob":"cw_请替换为bob的密钥"}'

# 企业微信客服
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_KF_SECRET=请填写微信客服Secret
WECOM_CALLBACK_TOKEN=请填写回调Token
WECOM_CALLBACK_ENCODING_AES_KEY=请填写43位EncodingAESKey
WECOM_OPEN_KF_IDS=wkxxxxxxxxxxxxxxxx
WECOM_ALLOWED_EXTERNAL_USERS=wmAlice,wmBob
WECOM_CALLBACK_PORT=3000

# 保护客服回复额度：跳过超过该时长的积压打印内容；同一客户的回复最小间隔。
# 默认分别为 PRINT_CONFIRMATION_TTL_MS（10 分钟）和 1200 毫秒。
# WECOM_CONFIRMATION_MAX_AGE_MS=600000
# WECOM_REPLY_MIN_INTERVAL_MS=1200
