# cups-web 与 CUPS
CUPS_WEB_URL=http://127.0.0.1:1180
PRINTER_URI=http://127.0.0.1:631/printers/Office_A4

# 共享 cups-web 账号模式：不设置 WECOM_CUPS_USER_CREDENTIALS 时启用。
# CUPS_WEB_USER=wecom-gateway
# CUPS_WEB_PASSWORD=请填写共享账号密码

# 每个个人微信用户使用独立 cups-web 账号：设置后优先于共享账号模式。
# 该 JSON 必须覆盖 WECOM_ALLOWED_EXTERNAL_USERS 中的每个 external_userid。
WECOM_CUPS_USER_CREDENTIALS='{"wmAlice":{"username":"alice","password":"请替换为alice的密码"},"wmBob":{"username":"bob","password":"请替换为bob的密码"}}'

# 企业微信客服
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_KF_SECRET=请填写微信客服Secret
WECOM_CALLBACK_TOKEN=请填写回调Token
WECOM_CALLBACK_ENCODING_AES_KEY=请填写43位EncodingAESKey
WECOM_OPEN_KF_IDS=wkxxxxxxxxxxxxxxxx
WECOM_ALLOWED_EXTERNAL_USERS=wmAlice,wmBob
WECOM_CALLBACK_PORT=3000
